# OPCIÓN A — Login genérico (funciona ya, cuota más baja):
# el email y contraseña con los que te registraste en mobilitylabs.emtmadrid.es
EMT_EMAIL=tu_email_aqui
EMT_PASSWORD=tu_contraseña_aqui

# OPCIÓN B — Login de app registrada (cuota más alta, requiere aprobación):
# rellena esto cuando tu app aparezca como "activa/aprobada" en el panel.
# Si están rellenas, el backend las usará en vez de EMT_EMAIL/EMT_PASSWORD.
EMT_CLIENT_ID=
EMT_PASS_KEY=

# Puerto en el que arranca el servidor proxy
PORT=3000
